# 在 PowerShell 中设置 DATABASE_URL。将 YOUR_PASSWORD 替换为已 URL 编码的本机密码。
DATABASE_URL=postgresql+psycopg://private_ops:YOUR_PASSWORD@127.0.0.1:5432/private_ops_dev
