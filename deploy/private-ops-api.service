[Unit]
Description=Private Ops API and web console
Requires=private-ops-postgres.service
After=private-ops-postgres.service

[Service]
User=private_ops
Group=private_ops
WorkingDirectory=/opt/private-ops/current/backend
EnvironmentFile=/etc/private-ops/runtime.env
EnvironmentFile=-/etc/private-ops/model.env
Environment=PRIVATE_OPS_FRONTEND_DIR=/opt/private-ops/current/frontend/dist
ExecStart=/opt/private-ops/venv/bin/python -m app.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
