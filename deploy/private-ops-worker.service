[Unit]
Description=Private Ops agent and task Worker
Requires=private-ops-postgres.service
After=private-ops-postgres.service

[Service]
User=private_ops
Group=private_ops
WorkingDirectory=/opt/private-ops/current/backend
EnvironmentFile=/etc/private-ops/runtime.env
EnvironmentFile=-/etc/private-ops/model.env
ExecStart=/opt/private-ops/venv/bin/python -m app.worker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
